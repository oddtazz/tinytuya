# Logging configuration
logging:
  level: "INFO"  # DEBUG for troubleshooting

# InfluxDB configuration
influxdb:
  token: "<INFLUX_TOKEN_AIR_QUALITY_WRITE>"
  org: "homelab"
  url: "http://10.100.10.225:8086"
  bucket: "air_quality"

# Tuya device configuration (LAN PRIMARY — data flows device -> LAN -> InfluxDB)
# Cloud API creds are used ONLY for local_key maintenance (error 914 rotation
# recovery / first-boot key fetch). Sensor data never transits Tuya's servers.
tuya:
  device_id: "<TUYA_DEVICE_ID>"
  api_key: "<TUYA_API_KEY>"
  api_secret: "<TUYA_API_SECRET>"
  region: "in"
  # --- LAN ---
  ip_address: "<DEVICE_LAN_IP>"   # pin with a DHCP reservation
  local_key: "<CURRENT_LOCAL_KEY>" # auto-refreshed from cloud on error 914
  version: 3.5

# General settings
general:
  polling_interval: 60  # seconds (LAN — no cloud quota to respect)
  status_timeout: 6     # seconds; a sleeping battery device times out, which is expected