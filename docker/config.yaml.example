# Example config — copy to config.yaml and fill in real values (config.yaml is gitignored).
# Precedence: environment variables (TUYA_*, INFLUX_*) override these values.
logging:
  level: "INFO"  # DEBUG for troubleshooting

influxdb:
  token: "<influxdb v2 write token for the air_quality bucket>"
  org: "homelab"
  url: "http://10.100.10.225:8086"
  bucket: "air_quality"

tuya:
  device_id: "<tuya device id>"
  api_key: "<tuya iot platform access id>"
  api_secret: "<tuya iot platform access secret>"
  region: "in"

general:
  polling_interval: 300  # seconds; cloud API quota friendly
